# WooDashboard — Bezpečnostní konfigurace

# ── Directory listing ──────────────────────────────────────────
Options -Indexes

# ── Ochrana citlivých souborů ──────────────────────────────────
<FilesMatch "\.(db|sqlite|sqlite3|json|log|sh|bak|env|ini)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(config\.php|import_stores\.php)$">
    Require all denied
</FilesMatch>

# Přístup k config.php a import_stores.php blokován vždy
# cron.php je přístupný přes HTTP, ale ověřuje token v PHP
<Files "config.php">
    Require all denied
</Files>

# ── Ochrana složek ─────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokuj přístup k data/ (SQLite DB, JSON cache)
    RewriteRule ^data(/.*)?$ - [F,L]

    # Blokuj přístup k src/ (PHP třídy)
    RewriteRule ^src(/.*)?$ - [F,L]

    # Blokuj přístup k lang/ (PHP soubory s citlivými daty)
    RewriteRule ^lang(/.*)?$ - [F,L]

    # Blokuj přístup k views/ (PHP šablony)
    RewriteRule ^views(/.*)?$ - [F,L]

    # Vynuť HTTPS
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Bezpečnostní HTTP hlavičky ─────────────────────────────────
<IfModule mod_headers.c>
    # Zabrání sniffování MIME typu
    Header always set X-Content-Type-Options "nosniff"

    # Zabrání načtení v iframe (Clickjacking)
    Header always set X-Frame-Options "DENY"

    # XSS Protection (starší prohlížeče)
    Header always set X-XSS-Protection "1; mode=block"

    # HSTS — vynuť HTTPS na rok (nezapínej dokud nemáš funkční SSL!)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Referrer Policy — neodesílej URL při přechodu na jiný web
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Content Security Policy — povol jen vlastní zdroje + Google Fonts
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"

    # Skryj verzi PHP a Apache
    Header always unset X-Powered-By
    Header always unset Server

    # Cache-Control pro citlivé stránky
    <FilesMatch "\.(php)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, private"
        Header always set Pragma "no-cache"
    </FilesMatch>

    # Statické assety mohou být cachovány
    <FilesMatch "\.(css|js|svg|png|jpg|ico|woff2)$">
        Header always set Cache-Control "public, max-age=86400"
    </FilesMatch>

    # Permissions Policy — zakáž nepotřebné browser funkce
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# ── Ochrana PHP souborů mimo veřejné ──────────────────────────
# Zabrání přímému spuštění PHP v upload složkách (kdyby byly)
<FilesMatch "\.php$">
    <If "%{REQUEST_URI} =~ m#^/(src|lang|views|data)/#">
        Require all denied
    </If>
</FilesMatch>
